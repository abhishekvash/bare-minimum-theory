{
	// SvelteKit 3 generates its base config as the `$app/tsconfig` package
	// (see https://svelte.dev/docs/kit/$app-tsconfig). It sets moduleResolution,
	// verbatimModuleSyntax, $app/types and friends; we only add what is ours.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "*.ts", "*.js"],
	"exclude": ["node_modules", ".svelte-kit", "build"]
}
