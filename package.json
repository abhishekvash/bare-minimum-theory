{
	"name": "bare-minimum-theory",
	"private": true,
	"version": "3.0.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"security:audit": "bun audit --audit-level=moderate",
		"security:deps": "bun outdated",
		"security:osv": "osv-scanner scan source -L bun.lock",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.10.0",
		"@sveltejs/adapter-cloudflare": "7.2.8",
		"@sveltejs/kit": "2.63.0",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/node": "22.19.1",
		"@vitest/ui": "4.1.0",
		"bits-ui": "2.14.4",
		"clsx": "2.1.1",
		"eslint": "10.4.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.19.0",
		"fake-indexeddb": "6.2.5",
		"globals": "16.5.0",
		"jsdom": "27.2.0",
		"mode-watcher": "1.1.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"sk-seo": "0.5.4",
		"svelte": "5.55.7",
		"svelte-check": "4.3.4",
		"svelte-sonner": "1.0.6",
		"tailwind-merge": "3.4.0",
		"tailwind-variants": "3.1.1",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.60.1",
		"vite": "7.3.2",
		"vitest": "4.1.0",
		"wrangler": "4.98.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "4.1.17",
		"@tonaljs/tonal": "4.10.0",
		"lucide-svelte": "0.553.0",
		"midi-writer-js": "3.1.1",
		"mobile-drag-drop": "3.0.0-rc.0",
		"tailwindcss": "4.1.17",
		"tone": "15.1.22"
	},
	"overrides": {
		"ajv": "6.14.0",
		"brace-expansion": ">=1.1.13 <2 || >=2.0.3 <3",
		"cookie": "0.7.0",
		"flatted": "3.4.2",
		"minimatch": ">=3.1.4 <4 || >=9.0.7 <11",
		"picomatch": ">=2.3.2 <3 || >=4.0.4 <5",
		"postcss": "8.5.10",
		"rollup": "4.59.0",
		"undici": "7.24.8",
		"ws": "8.20.1",
		"yaml": ">=1.10.3 <2 || >=2.8.3 <3"
	}
}
