{
	"name": "bare-minimum-theory",
	"private": true,
	"version": "3.0.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"security:audit": "bun audit --audit-level=moderate",
		"security:deps": "bun outdated",
		"security:osv": "osv-scanner scan source -L bun.lock",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.10.0",
		"@sveltejs/adapter-cloudflare": "7.2.8",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.4",
		"@types/node": "24.19.2",
		"@vitest/ui": "5.1.0",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"fake-indexeddb": "6.2.5",
		"globals": "17.14.0",
		"jsdom": "30.1.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.1.0",
		"wrangler": "4.157.0"
	},
	"dependencies": {
		"@lucide/svelte": "1.66.0",
		"@tonaljs/tonal": "4.10.0",
		"bits-ui": "2.20.3",
		"clsx": "2.1.1",
		"driver.js": "1.10.2",
		"midi-writer-js": "3.2.0",
		"mobile-drag-drop": "3.0.0-rc.0",
		"mode-watcher": "1.1.0",
		"sk-seo": "0.5.4",
		"svelte-sonner": "1.2.3",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.4",
		"tone": "15.1.22"
	},
	"overrides": {
		"ajv": "6.14.0",
		"brace-expansion": ">=1.1.13 <2 || >=2.1.7 <3 || >=5.0.12 <6",
		"cookie": "0.7.0",
		"flatted": "3.4.2",
		"minimatch": ">=3.1.4 <4 || >=9.0.7 <11",
		"picomatch": ">=2.3.2 <3 || >=4.0.4 <5",
		"postcss": "8.5.23",
		"undici": "7.30.1",
		"ws": "8.21.0",
		"yaml": ">=1.10.3 <2 || >=2.8.3 <3"
	}
}
